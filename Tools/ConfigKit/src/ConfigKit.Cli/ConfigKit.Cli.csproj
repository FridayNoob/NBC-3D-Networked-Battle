<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       ConfigKit.Cli —— 薄宿主：解析命令行 → 跑流水线 → 落盘 → 退出码
       ⚠️ 它是【宿主】，所以放开到 net8.0 + C# 12（不打算进 Unity）
       ⚠️ 它【只做】三件事：参数、写文件、退出码。
          "读/解析/校验/生成"全在 Core 里，所以那些逻辑不靠这个进程也能测。
       ======================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>NBC.ConfigKit.Cli</RootNamespace>
    <AssemblyName>NBC.ConfigKit.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ Cli 是「组合根」（composition root）：唯一"允许认识所有适配器"的地方。
         代价如实记下：从此 Cli 会**间接**依赖 NPOI，所以"没还原 NPOI 时 Cli 也能构建"
         这句话不再成立（Core / Delimited / SelfTest 仍然成立，它们零依赖）。
         换来的是：source 参数可以直接指向一个 .xlsx 目录。 -->
    <ProjectReference Include="..\ConfigKit.Core\ConfigKit.Core.csproj" />
    <ProjectReference Include="..\ConfigKit.Sources.Delimited\ConfigKit.Sources.Delimited.csproj" />
    <ProjectReference Include="..\ConfigKit.Sources.Xlsx\ConfigKit.Sources.Xlsx.csproj" />
  </ItemGroup>

</Project>

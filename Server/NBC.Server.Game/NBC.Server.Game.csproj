<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       NBC.Server.Game - 服务端战斗逻辑层
       职责：
         · 引入 NBC.Shared 的战斗核心逻辑（与客户端【同一份】代码）
         · 按 Tick 推进战斗模拟
         · 生成快照（状态同步）/ 收集输入并广播（帧同步）/ 生成关键帧（状态帧同步）
         · 权威战斗判定与结算数据生成
       ⚠️ 本层必须能被客户端复用同一份逻辑 - 因此战斗规则本身写在 NBC.Shared 里，
          本层只做"服务端侧的驱动与编排"
       ======================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NBC.Server.Game</RootNamespace>
    <AssemblyName>NBC.Server.Game</AssemblyName>
    <!--
      ⚠️ 这里**故意不加** NoWarn：`Framework\Fsm\**` 与 `Framework\Event\EventId.cs` 现在
      自己写了 `#nullable disable`（照 `Shared\` 的规矩），所以 nullable 噪音已经消掉；
      再加 `NoWarn` 只会把**本工程自己**的真实可空缺陷一起屏蔽掉。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBC.Shared\NBC.Shared.csproj" />
    <ProjectReference Include="..\NBC.Server.Core\NBC.Server.Core.csproj" />
  </ItemGroup>

  <!-- ========================================================================
       ★ A10 的状态机 + `EventId`：**服务端直接编源码复用**（M3-S6b 的 BOSS AI 用它）

       ⚠️ 为什么还要 `EventId.cs`：`StateBase.OnEvent(EventId id)` 用到它 ——
          **状态机自己那 5 个文件是纯 C#，但它引的 `EventId` 不是**（那句 `Debug.LogWarning`）。
          这是 D14 结论的**第二层**：判"能不能进服务端"要看**整条依赖链**。
       ⚠️ `UnityEngineDebugShim.cs`（本目录）就是为这一条日志准备的**编译期垫片**，
         红线与长期解写在那个文件头里。
       ======================================================================== -->
  <ItemGroup>
    <Compile Include="..\..\Client\Assets\_Project\Framework\Fsm\**\*.cs" />
    <Compile Include="..\..\Client\Assets\_Project\Framework\Event\EventId.cs" />
  </ItemGroup>

  <!-- ========================================================================
       ★ Google.Protobuf：**必须直接引一份**（2026-09-23，今天第四次撞同一条规律）

       `NBC.Server.Core` 引了它，但 `<Reference>`（裸程序集引用）**不传递** ——
       本工程生成快照时用到 `ServerMessage.ToByteArray()`（`Google.Protobuf` 的扩展方法），
       报错是 `CS0246: 未能找到类型或命名空间名"Google"`。
       📌 判据同上：**用到第三方类型就自己引**；报 CS0012 时读它的原文（会点名程序集）。
       ======================================================================== -->
  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\Client\Assets\ThirdParty\GoogleProtobuf\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>

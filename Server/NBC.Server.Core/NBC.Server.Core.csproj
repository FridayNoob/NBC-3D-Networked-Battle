<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       NBC.Server.Core - 服务端基础设施层
       职责（需求文档 §13.2、§13.3）：
         · 网络层：TcpListener / 粘包拆包 / 心跳 / 超时 / 会话管理
         · 消息分发：MsgId 注册表（显式注册，不用反射 - 见 NET-02）
         · 主循环：单线程定长 Tick（30Hz），网络 IO 回调只入队
         · 房间/大厅管理：RoomMgr / LobbyMgr
         · 帧循环与同步策略：状态同步 / 帧同步 / 状态帧同步
       ⚠️ 本层【禁止】引用 UnityEngine（服务端是纯 .NET 进程）
       ⚠️ 本层【禁止】被 Behavior Designer 等 Unity 插件污染（见 M0 手册 D14 实验）
       ======================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NBC.Server.Core</RootNamespace>
    <AssemblyName>NBC.Server.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBC.Shared\NBC.Shared.csproj" />
  </ItemGroup>

  <!-- ========================================================================
       ★ 协议（M3-S1）：protoc 从 Protocol/*.proto 生成，【两端引用同一批源码】
         客户端那边是 Client\Assets\_Project\Protocol\（自己的 asmdef `NBC.Protocol`）。
         生成产物【入库】，日常 clone / 编译不需要跑 protoc；改协议才跑
         （命令见 Protocol\nbc_m3.proto 顶部 / Docs\11 §5.2）。
       ======================================================================== -->
  <ItemGroup>
    <Compile Include="..\..\Client\Assets\_Project\Protocol\**\*.cs" />
  </ItemGroup>

  <!-- ========================================================================
       Google.Protobuf 3.21.1 —— 用【仓库里那份 DLL】（Assets\ThirdParty\GoogleProtobuf\）

       ⚠️ 不能用 PackageReference：本沙箱还原不了 NuGet（NU1301，见 Docs\11）
       ⚠️ 必须与 protoc 【同版本】（3.21.1）：混版本会得到"生成代码编译不过 / 运行期报错"，
          而且报错【不会】提示是版本问题
       ⚠️ 下面那段是 M0 时期的 protobuf-net 注释，2026-09-20 已换成 Google.Protobuf
          （原因：D17 实测 protobuf-net 在 IL2CPP 下含 repeated 字段必崩）—— 别再照着它做
       ======================================================================== -->
  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\Client\Assets\ThirdParty\GoogleProtobuf\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- ========================================================================
       ★ 日志：**一份源码，两边都编**（M1-D1 那条规矩；SRV-14）
       ========================================================================
       客户端那套日志里，有三个文件是**纯 BCL**（只用 `System` / `System.IO` / `System.Text`）：
         · `LogTypes.cs`     —— `LogLevel` / `LogChannel` / `LogEntry`
         · `ILogSink.cs`     —— 落盘接缝
         · `FileLogSink.cs`  —— **带滚动的文件落盘**（263 行，含三处真坑，见那个文件头）
       另外两个（`LogSystem` / `UnityConsoleLogSink`）**用了 UnityEngine**，所以不引。

       ⚠️ 为什么用 `<Compile Include>` 引**同一个文件**，而不是把它们拷进 Server\：
          拷贝两份**一定会漂移**，而漂移**不报错** —— 与 D1「一份源码两边都编」同一条理由。
          `FileLogSink` 尤其不能抄：它的滚动有三处"看起来能工作、其实靠运气"的细节
          （写之前滚动 / 自己记字节数 / 滚动后计数归零），抄错一处就是**日志把磁盘写满**。

       ⚠️ 代价（如实记）：服务端程序集里会出现 `NBC.Framework.Log` 这个命名空间 ——
          名字里的 `Framework` 在服务端读起来有点怪。但**同一个文件、同一个命名空间**
          正是"不漂移"的保证；改名要动客户端（Unity 要重导 `.meta`），收益只是好看。
          真正的修法是把它抽成**独立的双端程序集**（像 `NBC.Framework.Net` 那样），
          那属于独立一片，记在 `Docs\27` §十七。
       ======================================================================== -->
  <ItemGroup>
    <Compile Include="..\..\Client\Assets\_Project\Framework\Log\LogTypes.cs" />
    <Compile Include="..\..\Client\Assets\_Project\Framework\Log\ILogSink.cs" />
    <Compile Include="..\..\Client\Assets\_Project\Framework\Log\FileLogSink.cs" />
  </ItemGroup>

</Project>

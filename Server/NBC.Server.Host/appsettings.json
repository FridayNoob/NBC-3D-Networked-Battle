{
  "//": "NBC 服务端配置。对应需求文档 §13.3 SRV-01。M0 阶段仅占位，字段会被后续里程碑逐步使用。",

  "Server": {
    "//": "网络监听配置（M3 使用）",
    "ListenIp": "0.0.0.0",
    "ListenPort": 9000,
    "MaxConnections": 32,
    "HeartbeatTimeoutSeconds": 10,
    "ReconnectGraceSeconds": 60,
    "ProtocolVersion": 1
  },

  "Simulation": {
    "//": "逻辑帧配置（M4 使用）。LogicTickRate 必须与 NBC.Shared.SharedInfo.LogicTickRate 一致",
    "LogicTickRate": 30,
    "SnapshotSendRate": 20,
    "StateFrameIntervalTicks": 30,
    "DefaultSyncMode": "State"
  },

  "Database": {
    "//": "数据库配置（M3 使用）。⚠️ 密码请勿提交到 Git —— 用环境变量 NBC_DB_PASSWORD 覆盖",
    "Provider": "MySql",
    "Host": "127.0.0.1",
    "Port": 3306,
    "Database": "nbc_db",
    "User": "root",
    "Password": "",
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 10,
    "MaxPoolSize": 10
  },

  "Logging": {
    "//": "日志配置（M1 使用）",
    "Level": "Debug",
    "WriteToFile": true,
    "Directory": "Logs",
    "SplitByDay": true,
    "LogNetworkPackets": false
  }
}

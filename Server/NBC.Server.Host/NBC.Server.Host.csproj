<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       NBC.Server.Host - 服务端进程宿主（控制台）
       职责（需求文档 §13.3 SRV-01）：
         · 读 appsettings.json（端口 / DB 连接串 / Tick 率 / 日志级别）
         · 组装依赖（Core + Game）
         · 启动网络监听与主循环
         · Ctrl+C 优雅关闭（SRV-17）
       产物：Builds\Server\bin\Debug\net8.0\NBC.Server.Host.dll
            发布后：NBC.Server.exe
       ======================================================================== -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NBC.Server.Host</RootNamespace>
    <AssemblyName>NBC.Server.Host</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBC.Server.Core\NBC.Server.Core.csproj" />
    <ProjectReference Include="..\NBC.Server.Game\NBC.Server.Game.csproj" />
  </ItemGroup>

  <!-- ========================================================================
       ★ Google.Protobuf：**必须直接引一份**（2026-09-23 被编译器抓住）

       `NBC.Server.Core` 已经引了它，但 **ProjectReference 的引用不传递** ——
       本工程用到 `ClientMessage.Parser`（签名里有 `MessageParser<>`）和
       `ToByteArray()`（`Google.Protobuf` 里的扩展方法）时，编译器报：

           error CS0012: 类型"MessageParser<>"在未引用的程序集中定义。
                         必须添加对程序集"Google.Protobuf, Version=3.21.1.0…"的引用。

       📌 这和 Unity 侧 asmdef 那条规律**是同一条**（"引用不传递"，本项目已记过 8 次）：
          只是这次发生在 csproj 的第三方 DLL 上。
       📌 `Private=true`：Host 是**要运行的**进程，DLL 必须复制到输出目录；
          只在编译期引用的工程（`Private=false`）跑起来会报"找不到程序集"。
       ======================================================================== -->
  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\Client\Assets\ThirdParty\GoogleProtobuf\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 配置文件要随进程输出，且支持运行时修改（不嵌入） -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ========================================================================
      第三方依赖（M4-S3 接入，见需求文档 §5.2 / §13）
      ========================================================================

      ⚠️ **2026-09-26 实测：本机 NuGet 现在能还原了**（`dotnet restore` 2.5 秒成功，
         四个包全部落到全局缓存 `C:\Users\李云峰\.nuget\packages\`）。
         此前 `Docs\11` 记的「本沙箱还原不了 NuGet（NU1301）」**已经不成立** ——
         那条结论重新测过，不是猜的（见该文件已更新的说明）。

      ⚠️ **版本全部写死**（原来是 `2.*` / `8.*` 浮动版本）：
         浮动版本 = 换台机器还原可能拿到**不同的**依赖 ⇒ 与 D1「一份源码两边都编」、
         D2「定点数为了位级别确定」同一条判据：**构建也要可复现**。

      ⚠️ **`Dapper` / `MySqlConnector` 已移到 `NBC.Server.Data`**（见那个工程的文件头）：
         数据访问不属于 Host。Host 通过工程引用**传递地**拿到它们，输出目录里照样有。
         留在这里只会让"谁在碰数据库"变成两处都能答。
      ======================================================================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBC.Server.Data\NBC.Server.Data.csproj" />
  </ItemGroup>

</Project>
